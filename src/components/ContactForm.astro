---
---

<form class="bg-neutral-900 p-8 rounded-xl border border-neutral-800 space-y-6">
  <div>
    <label for="name" class="block text-white font-semibold mb-2">
      Nombre completo
    </label>
    <input
      type="text"
      id="name"
      name="name"
      required
      class="w-full px-4 py-3 bg-neutral-950 border border-neutral-800 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-yellow-400 transition-colors"
      placeholder="Tu nombre"
    />
  </div>

  <div>
    <label for="email" class="block text-white font-semibold mb-2">
      Correo electrónico
    </label>
    <input
      type="email"
      id="email"
      name="email"
      required
      class="w-full px-4 py-3 bg-neutral-950 border border-neutral-800 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-yellow-400 transition-colors"
      placeholder="tu@email.com"
    />
  </div>

  <div>
    <label for="phone" class="block text-white font-semibold mb-2">
      Teléfono
    </label>
    <input
      type="tel"
      id="phone"
      name="phone"
      class="w-full px-4 py-3 bg-neutral-950 border border-neutral-800 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-yellow-400 transition-colors"
      placeholder="+593 96 870 4627"
    />
  </div>

  <div>
    <label for="message" class="block text-white font-semibold mb-2">
      Mensaje
    </label>
    <textarea
      id="message"
      name="message"
      rows="5"
      required
      class="w-full px-4 py-3 bg-neutral-950 border border-neutral-800 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-yellow-400 transition-colors resize-none"
      placeholder="Cuéntanos tus objetivos de entrenamiento..."
    ></textarea>
  </div>

  <button
    type="submit"
    class="w-full bg-yellow-400 hover:bg-yellow-300 text-black px-8 py-4 rounded-lg font-bold text-lg transition-all transform hover:scale-105 flex items-center justify-center gap-3"
  >
    Send Mensaje
    <i class="ri-send-plane-line"></i>
  </button>
</form>

