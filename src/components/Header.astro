---
import { navigation, siteData, withBase } from '../data/siteData';
---

<header class="fixed flex items-center justify-center w-full z-50 bg-black/95 backdrop-blur-sm border-b border-yellow-400/20">
  <nav class="max-w-5xl w-full px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between py-3">
      <!-- Logo -->
      <div class="shrink-0 flex items-center">
        <a href={navigation[0].href} class="flex items-center gap-3">
          <div class="h-16 w-24 overflow-hidden flex items-center justify-center">
            <img
              src={withBase("/logo-gimnasio-macara.jpeg")}
              alt={`Logo ${siteData.name}`}
              class="h-28 w-28 object-contain scale-[1.3]"
            />
          </div>
          <span class="text-xl md:text-2xl font-bold text-yellow-400 font-heading tracking-tight">
            {siteData.name}
          </span>
        </a>
      </div>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex md:items-center md:justify-center md:gap-8">
        {navigation.map((item) => (
          <a
            href={item.href}
            class="text-gray-300 hover:text-yellow-400 transition-colors font-medium text-base py-2"
          >
            {item.name}
          </a>
        ))}
        <a
          href={withBase("/contact")}
          class="bg-yellow-400 hover:bg-yellow-300 text-black rounded-lg font-semibold transition-all duration-200 inline-flex items-center justify-center gap-2 px-6 py-2.5"
        >
          Inscríbete
          <i class="ri-arrow-right-line"></i>
        </a>
      </div>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-button"
        class="md:hidden text-white p-2 flex items-center justify-center"
        aria-label="Toggle menu"
      >
        <i id="menu-icon" class="ri-menu-line text-2xl"></i>
        <i id="close-icon" class="ri-close-line text-2xl hidden"></i>
      </button>
    </div>

    <!-- Mobile Navigation -->
    <div
      id="mobile-menu"
      class="hidden md:hidden pb-6 pt-2 space-y-2"
    >
      {navigation.map((item) => (
        <a
          href={item.href}
          class="block px-4 py-3 text-gray-300 hover:text-yellow-400 hover:bg-slate-800 rounded-lg transition-colors font-medium"
        >
          {item.name}
        </a>
      ))}
      <a
        href="/contact"
        class="flex items-center justify-center gap-2 px-6 py-3 bg-yellow-400 hover:bg-yellow-300 text-black rounded-lg text-center font-semibold transition-all duration-200 mt-2 shadow-md hover:shadow-lg"
      >
        Inscríbete
        <i class="ri-arrow-right-line"></i>
      </a>
    </div>
  </nav>
</header>

<script>
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');
  const closeIcon = document.getElementById('close-icon');

  mobileMenuButton?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
    menuIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  });
</script>

