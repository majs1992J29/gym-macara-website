---
import { siteData, withBase } from '@data/siteData';
---

<section class="relative min-h-screen flex items-center justify-center bg-linear-to-br from-black via-neutral-950 to-black pt-20 overflow-hidden">
  <!-- Background Pattern -->
  <div class="absolute inset-0 opacity-10">
    <div class="absolute inset-0" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 40px 40px;"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <!-- Text Content -->
      <div class="text-center lg:text-left">
        <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold text-white mb-6 leading-tight">
          {siteData.tagline}
        </h1>
        <p class="text-xl md:text-2xl text-gray-300 mb-8 leading-relaxed">
          {siteData.description}
        </p>
        <div class="flex flex-col sm:flex-row gap-4 sm:gap-6 justify-center lg:justify-start mb-12">
          <a
            href={withBase("/contact")}
            class="bg-yellow-400 hover:bg-yellow-300 text-black px-8 py-4 rounded-lg font-bold text-lg transition-all transform inline-flex items-center justify-center gap-3"
          >
            Empieza hoy
            <i class="ri-arrow-right-line"></i>
          </a>
          <a
            href={withBase("/about")}
            class="bg-transparent border-2 border-white text-white hover:bg-white hover:text-black px-8 py-4 rounded-lg font-bold text-lg transition-all inline-flex items-center justify-center gap-3"
          >
            Conoce más
            <i class="ri-information-line"></i>
          </a>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-3 gap-6 max-w-lg mx-auto lg:mx-0">
          <div class="text-center lg:text-left">
            <div class="text-4xl md:text-5xl font-bold text-yellow-400 mb-2">4.7</div>
            <div class="text-gray-300 text-sm md:text-base">Valoración</div>
          </div>
          <div class="text-center lg:text-left">
            <div class="text-4xl md:text-5xl font-bold text-yellow-400 mb-2">20+</div>
            <div class="text-gray-300 text-sm md:text-base">Reseñas</div>
          </div>
          <div class="text-center lg:text-left">
            <div class="text-4xl md:text-5xl font-bold text-yellow-400 mb-2">4:30</div>
            <div class="text-gray-300 text-sm md:text-base">AM apertura</div>
          </div>
        </div>
      </div>

      <!-- Hero Image -->
      <div class="hidden lg:block">
        <div class="relative">
          <div class="aspect-square rounded-2xl overflow-hidden bg-neutral-900  border-2 border-neutral-800 shadow-2xl">
            <img
              src={withBase("/home/hero.jpeg")}
              alt="Entrenamiento en Gimnasio Macará"
              width="800"
              height="800"
              class="w-full h-full object-cover"
              loading="eager"
            />
          </div>
          <div class="absolute -bottom-6 -left-6 bg-yellow-400 text-black p-6 rounded-xl shadow-xl">
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 bg-white rounded-lg flex items-center justify-center">
                <i class="ri-trophy-line text-2xl text-black"></i>
              </div>
              <div>
                <div class="text-black font-bold text-lg">Entrena con disciplina</div>
                <div class="text-black/70 text-sm">Gimnasio Macará</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll Indicator -->
  <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce hidden lg:block">
    <i class="ri-arrow-down-line text-2xl text-white"></i>
  </div>
</section>

