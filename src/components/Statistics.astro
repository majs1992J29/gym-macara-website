---
import { statistics } from '../data/siteData';
---

<section id="statistics" class="py-20 bg-linear-to-br from-black via-neutral-950 to-black">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-bold text-white mb-4">By The Numbers</h2>
      <p class="text-xl text-gray-300 max-w-2xl mx-auto">
        Our commitment to excellence shows in every metric
      </p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-6">
      {statistics.map((stat) => (
        <div class="bg-neutral-950/50 backdrop-blur-sm p-6 rounded-xl border border-neutral-800 text-center hover:border-yellow-400 transition-all transform hover:scale-105">
          <div class="w-16 h-16 bg-yellow-400/10 rounded-lg flex items-center justify-center mx-auto mb-4">
            <i class={`${stat.icon} text-3xl text-yellow-400`}></i>
          </div>
          <div class="text-3xl md:text-4xl font-bold text-yellow-400 mb-2">{stat.number}</div>
          <div class="text-gray-300 text-sm md:text-base">{stat.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>

