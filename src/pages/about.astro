---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { siteData, trainers, history } from "../data/siteData";
---

<Layout
  title={`Nosotros - ${siteData.name}`}
  description="Conoce la misión, los valores y los instructores de Gimnasio Macará"
>
  <!-- Hero Section -->
  <section
    class="pt-32 pb-20 bg-linear-to-br from-black via-neutral-950 to-black"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto">
        <h1 class="text-5xl md:text-6xl font-bold text-white mb-6">
          Nosotros
        </h1>
        <p class="text-xl text-gray-300">
          Somos un gimnasio en Macará enfocado en entrenamiento, fuerza, bienestar y acompañamiento técnico.
        </p>
      </div>
    </div>
  </section>

  <!-- Mission Section -->
  <section class="py-20 bg-neutral-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-4xl font-bold text-white mb-8 text-center">
          Nuestra misión
        </h2>
        <div class="prose prose-invert max-w-none">
          <p class="text-xl text-gray-300 mb-6">
            En Gimnasio Macará creemos que entrenar no es solo levantar peso: es construir disciplina, confianza, salud y constancia. Nuestro objetivo es ofrecer un espacio completo para que cada persona pueda mejorar su condición física a su propio ritmo.
          </p>
          <p class="text-lg text-gray-400 mb-6">
            Contamos con tres pisos de entrenamiento, área de cardio, zona de tren superior, zona de tren inferior, sauna, baño turco y dos instructores para orientar a los usuarios dentro del gimnasio.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Values Section -->
  <section class="py-20 bg-neutral-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-4xl font-bold text-white mb-12 text-center">
        Nuestros valores
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
        <div
          class="bg-neutral-950 p-8 rounded-xl border border-neutral-800 text-center hover:border-yellow-400 transition-all"
        >
          <div
            class="w-20 h-20 bg-yellow-400/10 rounded-lg flex items-center justify-center mx-auto mb-6"
          >
            <i class="ri-trophy-line text-4xl text-yellow-400"></i>
          </div>
          <h3 class="text-2xl font-bold text-white mb-3">Disciplina</h3>
          <p class="text-gray-400 leading-relaxed">
            We strive for excellence in everything we do, from our facilities to
            our service
          </p>
        </div>
        <div
          class="bg-neutral-950 p-8 rounded-xl border border-neutral-800 text-center hover:border-yellow-400 transition-all"
        >
          <div
            class="w-20 h-20 bg-yellow-400/10 rounded-lg flex items-center justify-center mx-auto mb-6"
          >
            <i class="ri-hand-heart-line text-4xl text-yellow-400"></i>
          </div>
          <h3 class="text-2xl font-bold text-white mb-3">Comunidad</h3>
          <p class="text-gray-400 leading-relaxed">
            Creamos un ambiente cercano para que cada persona pueda entrenar con confianza
          </p>
        </div>
        <div
          class="bg-neutral-950 p-8 rounded-xl border border-neutral-800 text-center hover:border-yellow-400 transition-all"
        >
          <div
            class="w-20 h-20 bg-yellow-400/10 rounded-lg flex items-center justify-center mx-auto mb-6"
          >
            <i class="ri-focus-3-line text-4xl text-yellow-400"></i>
          </div>
          <h3 class="text-2xl font-bold text-white mb-3">Resultados</h3>
          <p class="text-gray-400 leading-relaxed">
            Orientamos el entrenamiento hacia objetivos claros, progreso y bienestar
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- History/Timeline Section -->
  <section class="py-20 bg-neutral-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-4xl font-bold text-white mb-12 text-center">
        Nuestra historia
      </h2>
      <div class="max-w-4xl mx-auto">
        <div class="relative">
          <!-- Timeline Line -->
          <div
            class="absolute left-8 top-0 bottom-0 w-0.5 bg-yellow-400/30 hidden md:block"
          >
          </div>

          <div class="space-y-12">
            {
              history.map((milestone, index) => (
                <div class="relative flex items-start gap-6">
                  <div class="hidden md:block shrink-0">
                    <div class="w-16 h-16 bg-yellow-400 rounded-full flex items-center justify-center border-4 border-neutral-900">
                      <span class="text-white font-bold text-sm">
                        {milestone.year}
                      </span>
                    </div>
                  </div>
                  <div class="flex-1 bg-neutral-950 p-6 rounded-xl border border-neutral-800 hover:border-yellow-400 transition-all">
                    <div class="md:hidden mb-2">
                      <span class="bg-yellow-400 text-black px-3 py-1 rounded-full text-sm font-bold">
                        {milestone.year}
                      </span>
                    </div>
                    <h3 class="text-2xl font-bold text-white mb-2">
                      {milestone.title}
                    </h3>
                    <p class="text-gray-300 leading-relaxed">
                      {milestone.description}
                    </p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Team Section -->
  <section class="py-20 bg-neutral-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-4xl font-bold text-white mb-4 text-center">
        Entrenadores
      </h2>
      <p class="text-xl text-gray-300 mb-12 text-center max-w-2xl mx-auto">
        Conoce a nuestros instructores y su enfoque de entrenamiento
      </p>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 max-w-6xl mx-auto">
        {
          trainers.map((trainer) => (
            <div class="bg-neutral-900 p-8 rounded-xl border border-neutral-800 hover:border-yellow-400 transition-all">
              <div class="text-center mb-6">
                <div class="w-40 h-40 rounded-full mx-auto mb-4 overflow-hidden border-4 border-yellow-400/20">
                  <Image
                    src={trainer.image}
                    alt={`${trainer.name} - ${trainer.role}`}
                    width={400}
                    height={400}
                    class="w-full h-full object-cover"
                    loading="lazy"
                  />
                </div>

                <h3 class="text-xl font-bold text-white mb-2">
                  {trainer.name}
                </h3>

                <p class="text-yellow-400 mb-1 font-semibold">
                  {trainer.role}
                </p>

                <p class="text-gray-400 text-sm mb-3">
                  {trainer.specialization}
                </p>

                <p class="text-gray-500 text-xs">
                  {trainer.experience}
                </p>
              </div>

              <p class="text-gray-300 text-sm leading-relaxed mb-6 text-center">
                {trainer.bio}
              </p>

              {trainer.gallery && trainer.gallery.length > 0 && (
                <div class="mb-6">
                  <p class="text-sm text-yellow-400 font-semibold mb-3 text-center">
                    Galería
                  </p>

                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    {trainer.gallery.map((photo: string, index: number) => (
                      <img
                        src={photo}
                        alt={`${trainer.name} foto ${index + 1}`}
                        class="w-full h-52 md:h-60 object-cover rounded-lg border border-neutral-800 hover:border-yellow-400 hover:scale-[1.02] transition-all"
                        loading="lazy"
                      />
                    ))}
                  </div>
                </div>
              )}

              <div class="flex flex-wrap gap-2 justify-center">
                {trainer.certifications.map((cert) => (
                  <span class="bg-neutral-950 text-gray-300 text-xs px-3 py-1 rounded-full border border-neutral-800">
                    {cert}
                  </span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
