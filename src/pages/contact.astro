---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
import { siteData, socialLinks, contactInfo } from '../data/siteData';
---

<Layout title={`Contacto - ${siteData.name}`} description="Contáctanos para empezar tu entrenamiento">
  <!-- Hero Section -->
  <section class="pt-32 pb-20 bg-linear-to-br from-black via-neutral-950 to-black">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto">
        <h1 class="text-5xl md:text-6xl font-bold text-white mb-6">Contacto</h1>
        <p class="text-xl text-gray-300">
          Estamos aquí para ayudarte a empezar o continuar tu entrenamiento.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Info & Form -->
  <section class="py-20 bg-neutral-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 max-w-6xl mx-auto">
        <!-- Contact Information -->
        <div>
          <h2 class="text-3xl font-bold text-white mb-8">Ponte en contacto</h2>
          <div class="space-y-6">
            {contactInfo.map((info) => (
              <div class="flex items-start gap-4">
                <div class="bg-yellow-400 p-4 rounded-lg shrink-0">
                  <i class={`${info.icon} text-2xl text-white`}></i>
                </div>
                <div>
                  <h3 class="text-xl font-semibold text-white mb-2">{info.title}</h3>
                  {Array.isArray(info.content) ? (
                    info.content.map((line) => (
                      <p class="text-gray-400 leading-relaxed">{line}</p>
                    ))
                  ) : info.link ? (
                    <a href={info.link} class="text-gray-400 hover:text-yellow-400 transition-colors">
                      {info.content}
                    </a>
                  ) : (
                    <p class="text-gray-400 leading-relaxed">{info.content}</p>
                  )}
                </div>
              </div>
            ))}
          </div>

          <!-- Social Links -->
          <div class="mt-10">
            <h3 class="text-xl font-semibold text-white mb-4">Follow Us</h3>
            <div class="flex space-x-4">
              {socialLinks.map((social) => (
                <a
                  href={siteData.social[social.name as keyof typeof siteData.social]}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-12 h-12 bg-neutral-800 hover:bg-yellow-400 rounded-lg flex items-center justify-center transition-all"
                  aria-label={social.label}
                >
                  <i class={`${social.icon} text-xl text-white`}></i>
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- Contact Form -->
        <div>
          <ContactForm />
        </div>
      </div>
    </div>
  </section>

  <!-- Visit Expectations Section -->
  <section class="py-20 bg-neutral-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-4xl font-bold text-white mb-4 text-center">Qué puedes esperar en tu primera visita</h2>
      <p class="text-xl text-gray-300 mb-12 text-center max-w-2xl mx-auto">
        Tu primera visita es importante. Esto es lo que encontrarás en Gimnasio Macará.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto mb-12">
        <div class="bg-neutral-950 p-6 rounded-xl border border-neutral-800 text-center hover:border-yellow-400 transition-all">
          <div class="w-16 h-16 bg-yellow-400/10 rounded-lg flex items-center justify-center mx-auto mb-4">
            <i class="ri-user-search-line text-3xl text-yellow-400"></i>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Recorrido y asesoramiento</h3>
          <p class="text-gray-300 text-sm leading-relaxed">
            Te mostraremos las instalaciones y conversaremos sobre tus objetivos de entrenamiento.
          </p>
        </div>
        <div class="bg-neutral-950 p-6 rounded-xl border border-neutral-800 text-center hover:border-yellow-400 transition-all">
          <div class="w-16 h-16 bg-yellow-400/10 rounded-lg flex items-center justify-center mx-auto mb-4">
            <i class="ri-group-line text-3xl text-yellow-400"></i>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Conoce a nuestros instructores</h3>
          <p class="text-gray-300 text-sm leading-relaxed">
            Conocerás a los instructores que pueden orientarte dentro del gimnasio.
          </p>
        </div>
        <div class="bg-neutral-950 p-6 rounded-xl border border-neutral-800 text-center hover:border-yellow-400 transition-all">
          <div class="w-16 h-16 bg-yellow-400/10 rounded-lg flex items-center justify-center mx-auto mb-4">
            <i class="ri-file-list-3-line text-3xl text-yellow-400"></i>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Opciones de planes</h3>
          <p class="text-gray-300 text-sm leading-relaxed">
            Conoce los planes disponibles: día, semana, quincena, mensual, semestral y anual.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Tiempo de respuesta Section -->
  <section class="py-20 bg-neutral-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <div class="bg-neutral-900 p-8 rounded-xl border border-neutral-800">
          <div class="flex items-start gap-6">
            <div class="bg-yellow-400/10 p-4 rounded-lg shrink-0">
              <i class="ri-time-line text-4xl text-yellow-400"></i>
            </div>
            <div>
              <h3 class="text-2xl font-bold text-white mb-3">Tiempo de respuesta</h3>
              <p class="text-gray-300 mb-4 leading-relaxed">
                Te responderemos lo antes posible según el canal de contacto.
              </p>
              <ul class="space-y-3">
                <li class="flex items-start gap-3">
                  <i class="ri-checkbox-circle-fill text-yellow-400 text-xl mt-0.5"></i>
                  <div>
                    <span class="text-white font-semibold">Consultas por correo:</span>
                    <span class="text-gray-300"> Respondemos lo antes posible en días laborables</span>
                  </div>
                </li>
                <li class="flex items-start gap-3">
                  <i class="ri-checkbox-circle-fill text-yellow-400 text-xl mt-0.5"></i>
                  <div>
                    <span class="text-white font-semibold">Llamadas telefónicas:</span>
                    <span class="text-gray-300"> Disponibles durante el horario de atención</span>
                  </div>
                </li>
                <li class="flex items-start gap-3">
                  <i class="ri-checkbox-circle-fill text-yellow-400 text-xl mt-0.5"></i>
                  <div>
                    <span class="text-white font-semibold">Mensajes del formulario:</span>
                    <span class="text-gray-300"> Revisamos los mensajes y respondemos lo antes posible</span>
                  </div>
                </li>
                <li class="flex items-start gap-3">
                  <i class="ri-checkbox-circle-fill text-yellow-400 text-xl mt-0.5"></i>
                  <div>
                    <span class="text-white font-semibold">Casos urgentes:</span>
                    <span class="text-gray-300"> Llámanos directamente para una atención más rápida</span>
                  </div>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Map Section (Placeholder) -->
    <!-- Map Section -->
  <section class="py-20 bg-neutral-900">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-4xl font-bold text-white mb-12 text-center">
        Encuéntranos
      </h2>

      <div class="bg-neutral-950 p-4 md:p-6 rounded-xl border border-neutral-800">
        <div class="aspect-video rounded-lg overflow-hidden border border-neutral-800">
          <iframe
            title="Ubicación de Gimnasio Macará en Google Maps"
            src="https://www.google.com/maps?q=Gimnasio%20%22Macar%C3%A1%22%2C%20Macar%C3%A1%2C%20Loja%2C%20Ecuador&z=18&output=embed"
            class="w-full h-full"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>

        <div class="text-center mt-6">
          <p class="text-gray-300 mb-4">
            Calle 22 de Septiembre y Calle Macará, Macará, Loja, Ecuador.
          </p>

          <a
            href="https://www.google.com/maps/place/Gimnasio+%22Macar%C3%A1%22/@-4.3849179,-79.9460957,18z/data=!3m1!4b1!4m6!3m5!1s0x903503168cfd9ddf:0xda29222d2bd58df1!8m2!3d-4.3849179!4d-79.9449463!16s%2Fg%2F11csbfndcc?entry=ttu&g_ep=EgoyMDI2MDUyMC4wIKXMDSoASAFQAw%3D%3D"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-3 bg-yellow-400 hover:bg-yellow-300 text-black px-6 py-3 rounded-lg font-bold transition-all"
          >
            Abrir en Google Maps
            <i class="ri-map-pin-line"></i>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

