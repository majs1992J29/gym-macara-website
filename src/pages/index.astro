---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Statistics from '../components/Statistics.astro';
import Features from '../components/Features.astro';
import Facilities from '../components/Facilities.astro';
import Classes from '../components/Classes.astro';
import ClassSchedule from '../components/ClassSchedule.astro';
import PricingPlans from '../components/PricingPlans.astro';
import SuccessStories from '../components/SuccessStories.astro';
import Testimonials from '../components/Testimonials.astro';
import FAQ from '../components/FAQ.astro';
import { siteData, withBase } from '../data/siteData';
---

<Layout title={`${siteData.name} - ${siteData.tagline}`} description={siteData.description}>
  <Hero />
  <Statistics />
  <Features />
  <Facilities />
  <Classes />
  <ClassSchedule />
  <PricingPlans />
  <SuccessStories />
  <Testimonials />
  <FAQ />
  
  <!-- CTA Section -->
  <section class="py-20 bg-linear-to-r from-yellow-400 to-yellow-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-4xl md:text-5xl font-bold text-black mb-4">
        ¿Listo para empezar a entrenar?
      </h2>
      <p class="text-xl text-black/80 mb-8 max-w-2xl mx-auto">
        Consulta nuestros planes y empieza tu rutina en Gimnasio Macará.
      </p>
      <a
        href={withBase("/contact")}
        class="inline-flex items-center justify-center gap-3 bg-black text-yellow-400 hover:bg-neutral-900 px-8 py-4 rounded-lg font-bold text-lg transition-all transform hover:scale-105 shadow-lg"
      >
        Inscríbete hoy
        <i class="ri-arrow-right-line"></i>
      </a>
    </div>
  </section>
</Layout>
