---
import Layout from '../layouts/Layout.astro';
import PricingPlans from '../components/PricingPlans.astro';
import { siteData, pricingPlans, paymentOptions } from '../data/siteData';
---

<Layout title={`Planes - ${siteData.name}`} description="Elige el plan que mejor se adapte a tus objetivos de entrenamiento">
  <!-- Hero Section -->
  <section class="pt-32 pb-20 bg-linear-to-br from-black via-neutral-950 to-black">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto">
        <h1 class="text-5xl md:text-6xl font-bold text-white mb-6">Planes del gimnasio</h1>
        <p class="text-xl text-gray-300">
          Planes flexibles para entrenar según tu objetivo y disponibilidad
        </p>
      </div>
    </div>
  </section>

  <PricingPlans showHeading={false} />

  <!-- Comparison Table Section -->
  <section class="py-20 bg-neutral-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-4xl font-bold text-white mb-4 text-center">
        Comparación de planes
      </h2>
      <p class="text-xl text-gray-300 mb-12 text-center">
        Compara la duración y beneficios principales de cada plan disponible
      </p>

      <div class="bg-neutral-950 rounded-xl border border-neutral-800 overflow-x-auto">
        <table class="w-full text-left">
          <thead>
            <tr class="border-b border-neutral-800">
              <th class="px-6 py-4 font-bold text-white">Características</th>
              <th class="px-6 py-4 font-bold text-white text-center">Día</th>
              <th class="px-6 py-4 font-bold text-white text-center">Semana</th>
              <th class="px-6 py-4 font-bold text-white text-center">Quincena</th>
              <th class="px-6 py-4 font-bold text-white text-center">
                Mensual
                <span class="block text-yellow-400 text-sm font-normal mt-1">Más popular</span>
              </th>
              <th class="px-6 py-4 font-bold text-white text-center">Semestral</th>
              <th class="px-6 py-4 font-bold text-white text-center">Anual</th>
            </tr>
          </thead>

          <tbody class="divide-y divide-neutral-800">
            <tr>
              <td class="px-6 py-4 font-medium text-white">Duración</td>
              <td class="px-6 py-4 text-center text-gray-300">1 día</td>
              <td class="px-6 py-4 text-center text-gray-300">7 días</td>
              <td class="px-6 py-4 text-center text-gray-300">15 días</td>
              <td class="px-6 py-4 text-center text-gray-300">30 días</td>
              <td class="px-6 py-4 text-center text-gray-300">6 meses</td>
              <td class="px-6 py-4 text-center text-gray-300">1 año</td>
            </tr>

            <tr>
              <td class="px-6 py-4 font-medium text-white">Precio</td>
              <td class="px-6 py-4 text-center text-yellow-400 font-semibold">$3</td>
              <td class="px-6 py-4 text-center text-yellow-400 font-semibold">$10</td>
              <td class="px-6 py-4 text-center text-yellow-400 font-semibold">$15</td>
              <td class="px-6 py-4 text-center text-yellow-400 font-semibold">$25</td>
              <td class="px-6 py-4 text-center text-yellow-400 font-semibold">$125</td>
              <td class="px-6 py-4 text-center text-yellow-400 font-semibold">$250</td>
            </tr>

            <tr>
              <td class="px-6 py-4 font-medium text-white">Acceso al gimnasio</td>
              {Array(6).fill(0).map(() => (
                <td class="px-6 py-4 text-center">
                  <i class="ri-checkbox-circle-fill text-yellow-400 text-xl"></i>
                </td>
              ))}
            </tr>

            <tr>
              <td class="px-6 py-4 font-medium text-white">Tres pisos de entrenamiento</td>
              {Array(6).fill(0).map(() => (
                <td class="px-6 py-4 text-center">
                  <i class="ri-checkbox-circle-fill text-yellow-400 text-xl"></i>
                </td>
              ))}
            </tr>

            <tr>
              <td class="px-6 py-4 font-medium text-white">Zona de cardio</td>
              {Array(6).fill(0).map(() => (
                <td class="px-6 py-4 text-center">
                  <i class="ri-checkbox-circle-fill text-yellow-400 text-xl"></i>
                </td>
              ))}
            </tr>

            <tr>
              <td class="px-6 py-4 font-medium text-white">Asesoramiento en sala</td>
              {Array(6).fill(0).map(() => (
                <td class="px-6 py-4 text-center text-yellow-400 font-semibold">
                  Disponible
                </td>
              ))}
            </tr>

            <tr>
              <td class="px-6 py-4 font-medium text-white">Sauna y baño turco</td>
              {Array(6).fill(0).map(() => (
                <td class="px-6 py-4 text-center text-gray-300">
                  Consultar
                </td>
              ))}
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Opciones de pago Section -->
  <section class="py-20 bg-neutral-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-4xl font-bold text-white mb-12 text-center">Opciones de pago</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto mb-12">
        {paymentOptions.plans.map((plan) => (
          <div class="bg-neutral-950 p-6 rounded-xl border border-neutral-800 text-center hover:border-yellow-400 transition-all">
            <h3 class="text-2xl font-bold text-white mb-3">{plan.type}</h3>
            <p class="text-gray-300 leading-relaxed">{plan.description}</p>
          </div>
        ))}
      </div>
      
      <div class="max-w-4xl mx-auto">
        <div class="bg-neutral-950 p-8 rounded-xl border border-neutral-800 mb-8">
          <h3 class="text-2xl font-bold text-white mb-6 text-center">Métodos de pago aceptados</h3>
          <div class="flex flex-wrap justify-center gap-4">
            {paymentOptions.methods.map((method) => (
              <div class="bg-neutral-900 px-6 py-3 rounded-lg border border-neutral-800">
                <span class="text-gray-300 font-medium">{method}</span>
              </div>
            ))}
          </div>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="bg-yellow-400/10 border border-yellow-400/30 p-6 rounded-xl text-center">
            <i class="ri-shield-check-line text-4xl text-yellow-400 mb-4"></i>
            <h4 class="text-xl font-bold text-white mb-2">Condiciones de los planes</h4>
            <p class="text-gray-300">{paymentOptions.guarantee}</p>
          </div>
          <div class="bg-yellow-400/10 border border-yellow-400/30 p-6 rounded-xl text-center">
            <i class="ri-gift-line text-4xl text-yellow-400 mb-4"></i>
            <h4 class="text-xl font-bold text-white mb-2">Promociones disponibles</h4>
            <p class="text-gray-300">{paymentOptions.trial}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-20 bg-neutral-900">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-4xl font-bold text-white mb-12 text-center">Preguntas frecuentes</h2>
      <div class="max-w-3xl mx-auto space-y-6">
        <div class="bg-neutral-950 p-6 rounded-xl border border-neutral-800 hover:border-yellow-400 transition-all">
          <h3 class="text-xl font-bold text-white mb-3 flex items-center gap-2">
            <i class="ri-question-line text-yellow-400"></i>
            ¿Puedo cancelar mi plan en cualquier momento?
          </h3>
          <p class="text-gray-400 leading-relaxed">
            Consulta en recepción las condiciones de cancelación, vigencia y renovación de cada plan.
          </p>
        </div>
        <div class="bg-neutral-950 p-6 rounded-xl border border-neutral-800 hover:border-yellow-400 transition-all">
          <h3 class="text-xl font-bold text-white mb-3 flex items-center gap-2">
            <i class="ri-question-line text-yellow-400"></i>
            ¿Puedo probar el gimnasio antes de pagar un plan?
          </h3>
          <p class="text-gray-400 leading-relaxed">
            Puedes consultar en recepción las opciones disponibles para conocer el gimnasio y sus servicios.
          </p>
        </div>
        <div class="bg-neutral-950 p-6 rounded-xl border border-neutral-800 hover:border-yellow-400 transition-all">
          <h3 class="text-xl font-bold text-white mb-3 flex items-center gap-2">
            <i class="ri-question-line text-yellow-400"></i>
            ¿El gimnasio cuenta con instructores?
          </h3>
          <p class="text-gray-400 leading-relaxed">
            Consulta en recepción o por WhatsApp los detalles de cada plan y el asesoramiento disponible en sala.
          </p>
        </div>
        <div class="bg-neutral-950 p-6 rounded-xl border border-neutral-800 hover:border-yellow-400 transition-all">
          <h3 class="text-xl font-bold text-white mb-3 flex items-center gap-2">
            <i class="ri-question-line text-yellow-400"></i>
            ¿Qué métodos de pago aceptan?
          </h3>
          <p class="text-gray-400 leading-relaxed">
            Aceptamos pagos según los métodos disponibles en el gimnasio. Consulta en recepción para confirmar opciones de pago y condiciones.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 bg-linear-to-r from-yellow-400 to-yellow-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-4xl md:text-5xl font-bold text-white mb-4">
        ¿Listo para empezar?
      </h2>
      <p class="text-xl text-white/90 mb-8 max-w-2xl mx-auto">
        Contáctanos hoy para conocer el gimnasio y empezar tu proceso de entrenamiento
      </p>
      <a
        href="/contact"
        class="inline-flex items-center justify-center gap-3 bg-white text-yellow-400 hover:bg-neutral-100 px-8 py-4 rounded-lg font-bold text-lg transition-all transform hover:scale-105 shadow-lg"
      >
        Contacto
        <i class="ri-arrow-right-line"></i>
      </a>
    </div>
  </section>
</Layout>

